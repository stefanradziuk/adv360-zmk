#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define BS 0  // Base
#define RR 1  // Right-dominant base
#define MR 2  // Mirrored
#define FN 4  // Fn
#define MD 5  // Mod

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp MINUS &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &mo MD                                                            &mo MD &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp EQUAL
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp CAPS  &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LGUI &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp LALT &kp RALT                            &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &kp ESC  &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &mo MR   &mo FN    &kp ENTER &kp SPACE              &kp DOWN &kp UP  &kp LBKT &kp RBKT &mo FN
      >;
    };

    extra2 {
      // Copy of Base but can trigger mirroring from the RHS instead of LHS
      // To switch between LHS/RHS dominant:
      // - LHS: Mod + -
      // - LHS: Mod + =
      display-name = "Base R";
      bindings = <
        &kp MINUS &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &mo MD                                                          &mo MD &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp EQUAL
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp CAPS  &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LGUI &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp LALT &kp RALT                            &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo FN    &kp GRAVE &kp ESC  &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &mo FN   &mo MR    &kp ENTER &kp SPACE              &kp DOWN &kp UP  &kp LBKT &kp RBKT &mo FN
      >;
    };

    extra1 {
      display-name = "Mirrored";
      bindings = <
        &kp EQUAL &kp N0    &kp N9   &kp N8   &kp N7     &kp N6 &mo MD                                                          &mo MD &kp N5 &kp N4 &kp N3    &kp N2   &kp N1   &kp MINUS
        &kp BSLH  &kp P     &kp O    &kp I    &kp U      &kp Y  &none                                                            &none &kp T  &kp R  &kp E     &kp W    &kp Q    &kp TAB
        &kp SQT   &kp SEMI  &kp L    &kp K    &kp J      &kp H  &none           &kp RCTRL &kp LGUI &kp LGUI  &kp LCTRL           &none &kp G  &kp F  &kp D     &kp S    &kp A    &kp CAPS
        &kp RSHFT &kp FSLH  &kp DOT  &kp COMMA &kp M     &kp N                            &kp RALT &kp LALT                            &kp B  &kp V  &kp C     &kp X    &kp Z    &kp LSHFT
        &mo FN    &kp RBKT  &kp LBKT &kp UP   &kp DOWN                &kp SPACE &kp ENTER &trans   &trans    &kp DEL &kp BSPC              &kp RIGHT &kp LEFT  &kp ESC  &kp GRAVE &mo FN
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                          &mo MD &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LGUI &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo FN    &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp DOWN   &kp UP       &kp KP_DOT    &kp RBKT        &mo FN
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                          &mo MD &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &kp UP &trans &trans &trans  &none                                           &none &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
        &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans &none  &trans &trans &trans &trans        &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
        &trans &trans &trans &trans &trans &trans                      &kp HOME &kp PG_UP                &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &kp END &kp PG_DN &trans &trans          &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &to BS &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &to RR
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none              &bt BT_CLR &none &bt BT_CLR &bt BT_CLR                 &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &bl BL_INC   &bl BL_DEC                         &rgb_ug RGB_TOG &bl BL_TOG &none      &none &bl BL_TOG &rgb_ug RGB_TOG                              &bl BL_DEC   &bl BL_INC   &none &none &none
      >;
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
